PORT=4000
DB_URL=mongodb://localhost:27017/file-manager

API_URL=http://localhost:4000/api
CLIENT_URL=http://localhost:3000
UPLOAD_URL=./files
SESSION_PATH=./sessions

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
SESSION_SECRET=change-me-session

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=app-password

# Comma-separated emails granted the 'admin' role (can edit/delete/move/copy any user's items).
# Role is (re)computed against this list on every registration/login.
ADMIN_EMAILS=admin@example.com
